#!/bin/bash -i

set -u
set +m

file_list=iic_flist
top_tb=iic_mem_tb
testnum=10000

test=iic_mem_test_all_seq
all_test=(
    "iic_mem_test_overwrite"    "iic_mem_test_random"
    "iic_mem_test_slave"        "iic_mem_test_wr"
    "iic_mem_test_all_seq"      "iic_mem_test_all_random_seq")

declare -A test_running
declare -A test_seed
current_pid=0
run_all=0

cov_folder=iic_mem
coverage=0
coverage_levels=("user" "toggle" "branch" "line" "expr" "fsm")
cov_flag=""

wave_name=""
generate_wave=0
open_waveform=0

verbosity=UVM_MEDIUM
verbosity_levels=("UVM_NONE" "UVM_LOW" "UVM_MEDIUM" "UVM_HIGH" "UVM_FULL" "UVM_DEBUG")
check_verbosity=0

exit_code_arr=()

threads=2
jobs=12

is_random_seed=0

# Functions
gen_coverage() {
    verilator_coverage -write-info coverage/$1/$1.info coverage/$1/$1.dat
    cov_err=$?
    if [ $cov_err -ne 0 ]; then
        echo "Coverage error occured with error code $cov_err"
        exit $cov_err
    fi

    genhtml coverage/$1/$1.info --output-directory coverage_html/$1 > coverage/$1/${1}_coverage.log
    html_err=$?
    if [ $html_err -ne 0 ]; then
        echo "HTML generation error occured with error code $html_err"
        exit $html_err
    fi

    firefox coverage_html/$1/index.html &
    if [ $err -ne 0 ]; then
        echo "ERROR Occured"
        exit $err
    fi
}

check_coverage_level() {
    for cov_level in "$coverage_levels[@]"; do
        if [[ $1 == $cov_level ]]; then
            echo "--coverage-$1"
        elif [[ $1 == "--coverage" ]]; then
            echo "--coverage"
        else
            echo "exit"
        fi
    done
}

cleanup() {
    echo -e "\nKilling all V$top_tb and z3 processes"
    pkill V$top_tb
    pkill z3
}

check_zero_thread() {
    if [[ $threads -eq 0 ]]; then
        echo "Threads cannot be 0. Assigning 1 thread"
        threads=1
    fi
}

print_help() {
    echo "ARGUMENTS"
    echo "--test <Test Name>        Specifies which test to run"
    echo "--run-all                 Run all tests simultaneously"
    echo "--coverage                Enables coverage analysis (default to all)"
    echo "--coverage-level <Level>  Specifies coverage level"
    echo "--test-num <Number>       Specifies sequence/item/test iterations count per test"
    echo "--wave                    Enables waveform generation"
    echo "--open-wave               Opens the waveform after the simulation"
    echo "--verbosity <Level>       Specifies UVM Verbosity Level"
    echo "--rand-seed               Enables randomization of seed value"
    echo "--jobs <Jobs Count>       Specifies the number of threads used for for all verilator simulation"
    echo "--threads <Threads Count> Specifies the number of threads used for each verilator simulation"
    echo ""
    echo "TESTS"
    for test_str in "${all_test[@]}"; do 
        echo $test_str
    done
    echo ""
    echo "COVERAGE LEVELS"
        for coverage_str in "${coverage_levels[@]}"; do 
        echo $coverage_str
    done
    echo "See https://verilator.org/guide/latest/exe_verilator.html#cmdoption-coverage for more info"
    echo ""
    echo "UVM VERBOSITY LEVELS"
        for verbosity_str in "${verbosity_levels[@]}"; do 
        echo $verbosity_str
    done
    echo "See https://chipverify.com/uvm/report-functions for more info"
}

get_random_seed() {
    if [[ $is_random_seed -eq 0 ]]; then
        echo 1
    else
        echo $(( SRANDOM % 2147483648 ))
    fi
}

trap cleanup SIGINT

if [[ $# -eq 0 ]]; then
    echo "No Argument Found!"
    print_help
    exit 1
fi

while [[ $# -gt 0 ]]; do
    case "$1" in 
        --test)
            file_list=iic_flist;
            test=$2;
            top_tb=iic_mem_tb;
            cov_folder=$2
            shift 2 ;;
        --run-all)
            run_all=1;
            shift 1 ;;
        --coverage)
            coverage=1;
            cov_flag="--coverage"
            shift 1 ;;
        --coverage-level)
            cov_flag=$2
            shift 2 ;;
        --test-num)
            testnum=$2;
            shift 2 ;;
        --wave)
            generate_wave=1;
            shift 1 ;;
        --open-wave)
            open_waveform=1;
            shift 1 ;;
        --verbosity)
            verbosity=$2;
            check_verbosity=1;
            shift 2 ;;
        --rand-seed)
            is_random_seed=1;
            shift 1 ;;
        --jobs)
            jobs=$2;
            shift 2 ;;
        --threads)
            threads=$2;
            shift 2 ;;
        --help | -h)
            print_help
            exit 0
            ;;
        *)
            echo -e "Invalid Argument\n"
            print_help
            exit 1
            ;;
    esac
done

# Checks if user-defined verbosity level is valid
if [[ $check_verbosity -ne 0 ]]; then
    for level in "${verbosity_levels[@]}"; do
        if [[ "$verbosity" == "$level" ]]; then
            verbosity=$level
            break
        fi
    done
fi

if [[ $(check_coverage_level $cov_flag) == "exit" ]]; then
    echo "Invalid Coverage Level" 
    exit 1
fi

# Get the number of threads
check_zero_thread

verilator -Wno-fatal --binary -j $jobs --threads $threads --top-module $top_tb +incdir+$UVM_HOME $cov_flag +define+TEST_NUM=$testnum -f $file_list
err=$?

if [ $err -ne 0 ]; then
    echo "ERROR Occured"
    exit $err
fi

if [[ ! -d "test_logs" ]]; then
    mkdir -p "test_logs"
fi

# Check if run all is enabled
if [[ $run_all -ne 0 ]]; then
    echo -e "\nRUNNING THE TESTS (${threads} threads per test)\n"
    
    # Run the tests
    test_index=0
    currently_running=0
    threads_used=0
    while [[ ($test_index -lt "${#all_test[@]}") || $currently_running -ne 0 ]]; do
        while (( ( $threads_used + $threads <= $jobs ) && ($test_index < "${#all_test[@]}"))) ; do
            indiv_test="${all_test[$test_index]}"
            # Creating folders for the coverage results if coverage is enabled
            if [[ ! -d "coverage/${indiv_test}" && $coverage -ne 0 ]]; then
                mkdir -p "coverage/${indiv_test}"
            fi

            # Passes the waveform name if generation of waveform is enabled
            if [[ $generate_wave -ne 0 ]]; then
                if [[ ! -d "waveforms" ]]; then
                    mkdir -p "waveforms"
                fi
                wave_name="+WAVE_NAME=waveforms/$indiv_test"
            fi

            # Getting Seed
            seed=$(get_random_seed)
            
            {
                echo "=================================="
                echo "TEST NAME : $indiv_test"
                echo "SEED      : $seed"
                echo "VERBOSITY : $verbosity"
                echo "TOP MODULE: $top_tb"
                echo "=================================="
            } > "test_logs/${indiv_test}.log"

            # Running obj_dir
            {
                stdbuf -oL obj_dir/V${top_tb} +UVM_TESTNAME=$indiv_test $wave_name \
                    +verilator+seed+$seed +UVM_VERBOSITY=$verbosity +UVM_NO_RELNOTES \
                    +verilator+coverage+file+coverage/${indiv_test}/${indiv_test}.dat
            } >> "test_logs/${indiv_test}.log" &
            current_pid=$!
            test_running[$current_pid]=$indiv_test
            test_seed[$indiv_test]=$seed
            echo "Running ${indiv_test} with PID=${current_pid}"
            ((threads_used += $threads))
            ((test_index++))
            ((currently_running++))
        done

        # Wait for the tests to finish
        wait -n -p finished_pid
        exit_code=$?
        exit_code_arr+=($exit_code)
        if [ $exit_code -ne 0 ]; then
            echo "Test ${test_running[$finished_pid]} with PID=$finished_pid failed with exit code $exit_code"
        else
            echo "Test ${test_running[$finished_pid]} with PID=$finished_pid finished successfully"
        fi
        ((threads_used -= $threads))
        ((currently_running--))
    done

    if [[ $coverage -ne 0 ]]; then
        for indiv_test in "${all_test[@]}"; do
            gen_coverage $indiv_test
            echo "Coverage result generation for $indiv_test done!"
        done
    fi

    # Checks if the tests have error for waveform viewing
    if [[ $open_waveform -ne 0 ]]; then
        wave_count=0
        for indiv_test in "${all_test[@]}"; do
            if [[ "${exit_code_arr[$wave_count]}" -eq 0 ]]; then
                gnome-terminal --tab --title="$indiv_test" -- bash -c "surfer waveforms/$indiv_test.fst; exec bash"
                echo "Opening waveform for $indiv_test done!"
                ((wave_count++))
            fi
        done
    fi

else
    stdbuf -oL obj_dir/V${top_tb} +UVM_TESTNAME=$test $wave_name +UVM_VERBOSITY=$verbosity +verilator+coverage+file+coverage/${test}/${test}.dat > "${test}.log"
    echo -e "\nRunning ${test}"

    if [[ $coverage -ne 0 ]]; then
        gen_coverage $test
        echo "Coverage result generation for $test done!"
    fi

    if [[ $open_waveform -ne 0 ]]; then
        gnome-terminal --tab --title="$test" -- bash -c "surfer $test.fst; exec bash"
        echo "Opening waveform of $test"
    fi
fi
